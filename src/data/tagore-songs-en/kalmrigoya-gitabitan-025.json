  "9727": {
    "en": [
      "My heart has grown restless —",
      "ah, dear child, come just once!",
      "The night is deep, and I am alone —",
      "where do you linger at such an hour?",
      "My heart starts at the thunder of the clouds —",
      "who knows what will happen!"
