  "9733": {
    "en": [
      "Forgive me, father,",
      "I am a grievous sinner;",
      "unknowing, I have become guilty —",
      "is there no pardon for me?",
      "Oh! I can bear the torment no longer;",
      "where shall I find peace?",
      "If you do not show mercy,",
      "there is no way at all!",
      "I am poor and utterly lowly —",
      "forgive, forgive this anguished one;",
      "Lord, grant deliverance",
      "from this sea of sin.",
      "Kafi — Ara-theka"
    ],
