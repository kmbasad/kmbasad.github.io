  "9040": {
    "en": [
      "Sweetly, Lord, I hear your name today.",
      "Drinking the nectar of love, my soul is near to swooning,",
      "my tongue slack and numb with adoration."
    ],
    "align": [
      [["সুমধুর", "Sweetly"], ["শুনি", "hear"], ["আজি", "today"], ["প্রভু", "Lord"], ["তোমার", "your"], ["নাম", "name"]],
