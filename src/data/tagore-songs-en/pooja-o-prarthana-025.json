    ]
  },
  "9041": {
    "en": [
      "All hunger is stilled — his nectar of love — come, let us carry it home.",
      "There so many people have suffered so much grief; so many brothers are thirsting.",
      "Call everyone in his name to his own abode; let us all sing his praise.",
      "Keep, oh keep in mind the sorrowful and stricken; give them all a place in your heart.",
      "Ever gazing on him, forget yourself; make everyone your own.",
      "In gathering peace, in giving peace away, spend your life.",
      "That such joy exists — who has heard of it? Come, let us tell everyone.",
      "Say it, call out and say, 'Come to the Father's house; here there is no grief or burning.'"
    ],
    "align": [
      [["মিটিল", "stilled"], ["সব", "All"], ["ক্ষুধা", "hunger"], ["তাঁহার", "his"], ["প্রেমসুধা", "nectar of love"], ["চলো", "come"], ["ঘরে", "home"], ["লয়ে", "carry"]],
