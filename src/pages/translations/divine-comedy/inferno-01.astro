---
import Base from '../../../layouts/Base.astro';
import BookReader from '../../../components/BookReader.astro';
import { translationWorks } from '../../../data/translation-works.js';

// breadcrumb names come straight from the catalogue — exactly the titles
// the landing page prints (cantos are bare numerals in its grid)
const work = translationWorks.find((w) => w.slug === 'divine-comedy')!;
const canticle = work.canticles!.find((c) => c.slug === 'inferno')!;
---

<Base
  section="translations"
  bodyClass="book-page"
  styles={['/css/translation-table.css', '/css/book.css']}
  navTitle={`${canticle.title} ১`}
  navParentHref="/translations/divine-comedy/" navParentLabel={work.title}
>
  <Fragment slot="head">
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap"
      rel="stylesheet"
    />
  </Fragment>

  <BookReader title={`${canticle.title} ১`} work={work.title}
    config={{
      src: 'inferno-01.md',
      dict: 'inferno-01-words.md',
      dictLang: 'it',
      toc: '/translations/divine-comedy/'
    }}
  />
</Base>
