---
import Base from '../../../layouts/Base.astro';
import Painting from '../../../components/Painting.astro';
import { translationWorks } from '../../../data/translation-works.js';
import { compositions, INK } from '../../../data/compositions.js';

// the painting behind this index: three zones, see compositions.js
const art = compositions['divine-comedy'];

const work = translationWorks.find((w) => w.slug === 'divine-comedy')!;

function toBn(n: number): string {
  return String(n).replace(/[0-9]/g, (d) => '০১২৩৪৫৬৭৮৯'[Number(d)]);
}

// canticle titles come from the catalogue (the same names the breadcrumbs
// use); counts and the published set are this page's own knowledge
const shape: Record<string, { count: number; existing: Set<string> }> = {
  inferno:    { count: 34, existing: new Set(['inferno-01']) },
  purgatorio: { count: 33, existing: new Set<string>() },
  paradiso:   { count: 33, existing: new Set<string>() },
};
const canticles = work.canticles!.map((c) => ({ ...c, ...shape[c.slug] }));
---

<Base
  section="translations"
  bodyClass="painting-page"
  styles={['/css/painting.css']}
  navTitle={work.title}
  navParentHref="/translations/"
  navParentLabel="অনুবাদ"
>
  <Painting planes={art.planes} sheet={art.sheet} gap={12} ground={INK} label={art.label}>
    <h1>{work.title}</h1>

    <div class="dc-canticles">
      {canticles.map((c) => (
        <div class="dc-canticle">
          <p class="dc-canticle-label">{c.title}</p>
          <div class="canto-grid">
            {Array.from({ length: c.count }, (_, i) => {
              const n = i + 1;
              const slug = `${c.slug}-${String(n).padStart(2, '0')}`;
              const bn = toBn(n);
              return c.existing.has(slug)
                ? <a href={`/translations/divine-comedy/${slug}/`} class="canto-num">{bn}</a>
                : <span class="canto-num canto-num--off">{bn}</span>;
            })}
          </div>
        </div>
      ))}
    </div>
  </Painting>
</Base>
