---
import Base from '../../../layouts/Base.astro';
import BookReader from '../../../components/BookReader.astro';
import { translationWorks } from '../../../data/translation-works.js';

// breadcrumb names come straight from the catalogue — exactly the titles
// the landing pages print
const work = translationWorks.find((w) => w.slug === 'divan')!;
const part = work.parts!.find((p) => p.slug === 'dvitiya')!;
---

<Base
  section="translations"
  bodyClass="book-page"
  styles={['/css/translation-table.css', '/css/book.css']}
  navTitle={part.title} navParentHref="/translations/divan/" navParentLabel={work.title}
>
  <Fragment slot="head">
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&display=swap"
      rel="stylesheet"
    />
  </Fragment>

  <BookReader
    config={{
      src: 'dvitiya.md',
      dict: 'dvitiya-words.md',
      dictLang: 'fa',
      tocStyle: 'grid',
      toc: '/translations/divan/'
    }}
  />
</Base>
