---
import Base from '../layouts/Base.astro';
import Mark from '../components/Mark.astro';
import ContactIcons from '../components/ContactIcons.astro';
import { ROOMS, SITE_NAME } from '../data/rooms.js';
import { AUTHOR_EN, LICENSE, DECLARATION } from '../data/site.js';

/* The front door is one painting, after Mondrian's grids of 1913-14, filling
   the screen edge to edge, and the page is made of the painting itself: the
   name and the five rooms are planes of it like any other, cut on the same
   grid, parted by the same charcoal lines, only larger and in their own
   tints. Nothing is laid on top. Every other plane is the painting's quiet
   matter (off-whites, greys, pale tints, a deeper note here and there), and
   now and then one of them breathes, deepening and fading back.

   The tiling is generated at build time from a fixed seed: the reserved
   planes first, then the rest of the grid filled greedily with rectangles,
   so every unit is covered and every line runs through. Phones get a
   composition of their own on a narrower, taller grid. */

const TAGLINE = 'মানুষের প্রাকৃতিক যৌথ-অচেতনে কৃত্রিম অভিযান';

const seeded = (seed) => () => {
  seed = (seed + 0x6d2b79f5) | 0;
  let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
  t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
  return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
};

// the painting's quiet matter: mostly light, the tints rarer, deep notes rarest
const PALETTE = [
  ['#f3f1ea', 20], ['#e8e6de', 12], ['#dfe2e6', 10], ['#cddae5', 11], ['#d9d5e6', 10],
  ['#ecdfe3', 8], ['#efe2b9', 7], ['#dadcbd', 6], ['#bcd0df', 4], ['#93b3cb', 2],
  ['#c8a5b3', 2], ['#cfae5a', 2], ['#a4a872', 1],
];

const compose = ({ cols, rows, reserved, maxW, maxH, seed }) => {
  const rnd = seeded(seed);
  const total = PALETTE.reduce((a, [, w]) => a + w, 0);
  const pick = () => {
    let r = rnd() * total;
    for (const [c, w] of PALETTE) if ((r -= w) <= 0) return c;
    return PALETTE[0][0];
  };
  const taken = Array.from({ length: rows }, () => Array(cols).fill(false));
  for (const r of reserved)
    for (let y = r.y; y < r.y + r.h; y++)
      for (let x = r.x; x < r.x + r.w; x++) taken[y][x] = true;
  const planes = [];
  for (let y = 0; y < rows; y++)
    for (let x = 0; x < cols; x++) {
      if (taken[y][x]) continue;
      let w = 1 + Math.floor(rnd() * maxW), h = 1 + Math.floor(rnd() * maxH);
      w = Math.min(w, cols - x);
      for (let i = 1; i < w; i++) if (taken[y][x + i]) { w = i; break; }
      h = Math.min(h, rows - y);
      for (let j = 1; j < h; j++)
        if (taken[y + j].slice(x, x + w).some(Boolean)) { h = j; break; }
      for (let j = 0; j < h; j++) for (let i = 0; i < w; i++) taken[y + j][x + i] = true;
      planes.push({ x, y, w, h, c: pick() });
    }
  return planes;
};

const area = (r) => `grid-area:${r.y + 1} / ${r.x + 1} / span ${r.h} / span ${r.w}`;

// the wide screen: 24 by 12
const D = { cols: 24, rows: 12 };
const dName = { x: 1, y: 2, w: 10, h: 4 };
const dRooms = [
  { x: 12, y: 1, w: 7, h: 5 },
  { x: 19, y: 2, w: 5, h: 4 },
  { x: 1, y: 7, w: 5, h: 4 },
  { x: 7, y: 7, w: 4, h: 4 },
  { x: 12, y: 7, w: 6, h: 4 },
];
const dMeta = { x: 19, y: 8, w: 5, h: 3 };
const desktop = compose({ ...D, reserved: [dName, ...dRooms, dMeta], maxW: 3, maxH: 2, seed: 1913 });

// phones: 8 by 19, the same planes stacked two by two, the fifth alone
const P = { cols: 8, rows: 19 };
const pName = { x: 0, y: 1, w: 7, h: 4 };
const pRooms = [
  { x: 0, y: 5, w: 4, h: 4 },
  { x: 4, y: 5, w: 4, h: 4 },
  { x: 0, y: 9, w: 4, h: 4 },
  { x: 4, y: 9, w: 4, h: 4 },
  { x: 0, y: 13, w: 5, h: 3 },
];
const pMeta = { x: 0, y: 16, w: 8, h: 3 };
const phone = compose({ ...P, reserved: [pName, ...pRooms, pMeta], maxW: 3, maxH: 2, seed: 1914 });

const both = (d, p) => `--d:${d.y + 1} / ${d.x + 1} / span ${d.h} / span ${d.w};--p:${p.y + 1} / ${p.x + 1} / span ${p.h} / span ${p.w}`;
const BN = (n) => String(n).padStart(2, '0').replace(/\d/g, (d) => String.fromCharCode(0x09e6 + +d));
---

<Base title={SITE_NAME} chrome={false} bodyClass="home-page" styles={['/css/home.css']}>
  <main class="home">
    <!-- the painting's quiet matter, on the wide screen and on a phone -->
    <div class="home-grid home-grid--d" aria-hidden="true">
      {desktop.map((p) => <span class="mc" style={`${area(p)};--c:${p.c}`}></span>)}
    </div>
    <div class="home-grid home-grid--p" aria-hidden="true">
      {phone.map((p) => <span class="mc" style={`${area(p)};--c:${p.c}`}></span>)}
    </div>

    <!-- the planes that carry the page, in the same grid -->
    <div class="home-grid home-grid--live">
      <section class="hp hp--name" style={both(dName, pName)}>
        <!-- the mark, by itself, at the plane's top-right corner -->
        <Mark class="home-mark" breathe />
        <h1 class="home-name">{SITE_NAME}</h1>
        <p class="home-tagline">{TAGLINE}</p>
      </section>

      {ROOMS.map((r, i) => (
        <a class={`hp hp--room room-${r.tint}`} href={r.href} style={both(dRooms[i], pRooms[i])}>
          <span class="hr-num">{BN(i + 1)}</span>
          <svg class="hr-go" viewBox="0 0 20 20" aria-hidden="true"><path d="M5 15L15 5M7 5h8v8" /></svg>
          <span class="hr-label">{r.label}</span>
          <span class="hr-gloss">{r.gloss}</span>
        </a>
      ))}

      <!-- who made it, and how to reach him -->
      <footer class="hp hp--meta" style={both(dMeta, pMeta)}>
        <span class="home-author">{AUTHOR_EN}</span>
        <ContactIcons />
        <span class="home-declare">{DECLARATION}</span>
        <a class="home-license" href={LICENSE.href} rel="license">{LICENSE.name}</a>
      </footer>
    </div>
  </main>

  <script is:inline>
    /* the painting breathes: now and then one plane deepens and fades back */
    (function () {
      if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
      setInterval(function () {
        if (document.hidden) return;
        var tall = matchMedia('(max-width: 760px), (orientation: portrait) and (max-width: 1099px)').matches;
        var grid = document.querySelector(tall ? '.home-grid--p' : '.home-grid--d');
        if (!grid) return;
        var m = grid.children[Math.floor(Math.random() * grid.children.length)];
        m.classList.add('pulse');
        setTimeout(function () { m.classList.remove('pulse'); }, 2400);
      }, 650);
    })();
  </script>
</Base>
