---
import Base from '../layouts/Base.astro';

/* The graduated limb of an instrument, printed faint behind the name — the
   one mark of the astronomer on an otherwise plain page. Degrees every 5°,
   the long ticks every 30°, and a dot at the zenith. */
const R = 250, R_IN = 232;
const ticks = Array.from({ length: 72 }, (_, i) => {
  const deg = i * 5;
  const rad = (deg - 90) * Math.PI / 180;
  const inner = deg % 30 === 0 ? 228 : 240;
  return {
    x1: 300 + R * Math.cos(rad), y1: 300 + R * Math.sin(rad),
    x2: 300 + inner * Math.cos(rad), y2: 300 + inner * Math.sin(rad),
    long: deg % 30 === 0,
  };
});
---

<Base title="যৌথ অচেতন" bodyClass="home-page" styles={['/css/home.css']}>
  <div class="home-stage">
    <div class="home-center">
      <svg class="home-plate" viewBox="0 0 600 600" aria-hidden="true" focusable="false">
        <circle class="home-plate-ring" cx="300" cy="300" r={R} />
        <circle class="home-plate-ring home-plate-ring--in" cx="300" cy="300" r={R_IN} />
        {ticks.map((t) => (
          <line class={t.long ? 'home-plate-tick home-plate-tick--long' : 'home-plate-tick'}
                x1={t.x1.toFixed(2)} y1={t.y1.toFixed(2)}
                x2={t.x2.toFixed(2)} y2={t.y2.toFixed(2)} />
        ))}
        <circle class="home-plate-zenith" cx="300" cy={300 - R} r="4" />
      </svg>

      <h1 class="home-name">খান মুহাম্মদ বিন আসাদ</h1>
      <p class="home-tagline">মানুষের যৌথ অচেতনে ব্যক্তিগত অভিযান</p>

      <div class="home-divider"></div>

      <nav class="home-sections">
        <a href="/panthea/" class="home-section">
          <span class="home-section-label">প্যান্থিয়া</span>
          <span class="home-section-sub">গল্পের ধারা</span>
        </a>
        <a href="/pangea/" class="home-section">
          <span class="home-section-label">প্যাঞ্জিয়া</span>
          <span class="home-section-sub">বাংলা সাহিত্যের আর্কাইভ</span>
        </a>
        <a href="/translations/" class="home-section">
          <span class="home-section-label">অনুবাদ</span>
          <span class="home-section-sub">বিশ্বসাহিত্যের অনুবাদ</span>
        </a>
        <a href="/trellises/" class="home-section">
          <span class="home-section-label">মাচা</span>
          <span class="home-section-sub">প্রবন্ধ</span>
        </a>
      </nav>

      <div class="home-meta">
        <a href="mailto:kasad@iub.edu.bd">kasad@iub.edu.bd</a>
        <span class="home-meta-sep">·</span>
        <a href="https://cassa.bd/people/asad/">cassa.bd/people/asad</a>
        <span class="home-meta-sep">·</span>
        <a href="https://www.facebook.com/kmbasad">Facebook</a>
      </div>

      <p class="home-license">
        <a href="https://creativecommons.org/licenses/by-nc-sa/4.0/">CC BY-NC-SA 4.0</a>
      </p>
    </div>
  </div>
</Base>
