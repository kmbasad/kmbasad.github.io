---
import Base from '../../layouts/Base.astro';

// The section's one-liner and its fuller account live in Markdown,
// src/stories/trellises/about.md: frontmatter `lede` (the line under the
// title), `more` (the key that opens the account) and `title` (the panel's
// heading), then the account itself as plain paragraphs. Globbed so the page
// still builds without it.
const mods = import.meta.glob('../../stories/trellises/about.md', { eager: true });
const about = mods['../../stories/trellises/about.md'] as any;
const fm = about?.frontmatter ?? {};
const About = about?.Content ?? null;

import Painting from '../../components/Painting.astro';

/* After Paul Klee, "Castle and Sun" (1928): a mosaic of small warm planes,
   oranges, reds, ochres and plums on a paper ground, laid by the hand; the
   trellises are themselves Klee "magic squares", so their room is a Klee.
   Two tilings from fixed seeds, one for the wide screen and one for the
   phone's strip; each is parked under the list's sheet on the other. */
const KLEE = ['#d9643a', '#e8a04a', '#c03a2b', '#f0c75a', '#8a3b5a', '#5a2f4a', '#e7b07a', '#b85a3a', '#e6c58f', '#3f2f4a'];
const tile = (cols, rows, seed) => {
  let h = seed;
  const rnd = () => ((h = (h * 1103515245 + 12345) % 2147483648) / 2147483648);
  const taken = Array.from({ length: rows }, () => Array(cols).fill(false));
  const out = [];
  for (let y = 0; y < rows; y++)
    for (let x = 0; x < cols; x++) {
      if (taken[y][x]) continue;
      let w = 1 + Math.floor(rnd() * 3), hh = 1 + Math.floor(rnd() * 2);
      w = Math.min(w, cols - x);
      for (let i = 1; i < w; i++) if (taken[y][x + i]) { w = i; break; }
      hh = Math.min(hh, rows - y);
      for (let j = 0; j < hh; j++) for (let i = 0; i < w; i++) taken[y + j][x + i] = true;
      out.push({ x: (x / cols) * 100, y: (y / rows) * 100, w: (w / cols) * 100, h: (hh / rows) * 100, c: KLEE[Math.floor(rnd() * KLEE.length)] });
    }
  return out;
};
const UNDER_D = [12, 0, 30, 30], UNDER_P = [0, 0, 40, 40];
const planes = [
  ...tile(30, 18, 1928).map((t) => ({ bg: t.c, d: [t.x, t.y, t.w, t.h], p: UNDER_P })),
  ...tile(3, 26, 1929).map((t) => ({ bg: t.c, d: UNDER_D, p: [86 + t.x * 0.14, t.y, t.w * 0.14, t.h] })),
];
---

<Base title="মাচা" section="trellises" bodyClass="painting-page" styles={['/css/painting.css']}>

  <Painting planes={planes} sheet={{ d: [8, 42], p: [0, 86] }} gap={3} ground="#efe5cf" paper="#fbf7ee" rule="#2e2433"
            label="Paul Klee, Castle and Sun (1928)">
    <h1>মাচা</h1>
    {fm.lede && <p class="pt-lede">{fm.lede}</p>}
    {About && (
      <p class="macha-more-line">
        <button class="macha-more" type="button" aria-expanded="false" aria-controls="macha-about">
          {fm.more}<span class="macha-more-arrow" aria-hidden="true">→</span>
        </button>
      </p>
    )}
    <ul class="pt-list">
      <!-- ARTICLES_START -->
        <li>
          <a href="/trellises/kiarostami/" style="--m:#c03a2b">
            <span class="pt-mark" aria-hidden="true"></span>
            <span class="pt-name">আব্বাস কিয়ারোস্তামি</span>
            <span class="pt-go" aria-hidden="true">→</span>
          </a>
        </li>
        <li>
          <a href="/trellises/god/" style="--m:#e8a04a">
            <span class="pt-mark" aria-hidden="true"></span>
            <span class="pt-name">খোদা</span>
            <span class="pt-go" aria-hidden="true">→</span>
          </a>
        </li>
        <li>
          <a href="/trellises/consciousness/" style="--m:#5a2f4a">
            <span class="pt-mark" aria-hidden="true"></span>
            <span class="pt-name">চেতনা</span>
            <span class="pt-go" aria-hidden="true">→</span>
          </a>
        </li>
        <li>
          <a href="/trellises/chan-wook/" style="--m:#f0c75a">
            <span class="pt-mark" aria-hidden="true"></span>
            <span class="pt-name">পাক চান-উক</span>
            <span class="pt-go" aria-hidden="true">→</span>
          </a>
        </li>
        <li>
          <a href="/trellises/ray/" style="--m:#8a3b5a">
            <span class="pt-mark" aria-hidden="true"></span>
            <span class="pt-name">সত্যজিৎ রায়</span>
            <span class="pt-go" aria-hidden="true">→</span>
          </a>
        </li>
      <!-- ARTICLES_END -->
    </ul>
  </Painting>

  <!-- the fuller account: a reading panel that slides in from the right
       (the whole screen on a phone); Esc, the x or the shade close it -->
  {About && (
    <div class="macha-about" id="macha-about" aria-hidden="true">
      <div class="macha-about-shade" data-close></div>
      <section class="macha-about-panel" role="dialog" aria-modal="true" aria-labelledby="macha-about-title">
        <button class="macha-about-close" type="button" data-close aria-label="বন্ধ">×</button>
        <h2 class="macha-about-title" id="macha-about-title">{fm.title}</h2>
        <div class="macha-about-body">
          <About />
        </div>
      </section>
    </div>
  )}

  <script is:inline>
    (function () {
      var key = document.querySelector('.macha-more');
      var box = document.getElementById('macha-about');
      if (!key || !box) return;
      var root = document.documentElement;
      var last = null;
      function set(open) {
        root.classList.toggle('about-open', open);
        box.setAttribute('aria-hidden', String(!open));
        key.setAttribute('aria-expanded', String(open));
        if (open) {
          last = document.activeElement;
          box.querySelector('.macha-about-close').focus({ preventScroll: true });
        } else if (last) {
          last.focus({ preventScroll: true });
        }
      }
      key.addEventListener('click', function () { set(true); });
      box.addEventListener('click', function (e) {
        if (e.target.closest('[data-close]')) set(false);
      });
      document.addEventListener('keydown', function (e) {
        if (e.key === 'Escape' && root.classList.contains('about-open')) set(false);
      });
    })();
  </script>

  <style>
    /* the one-liner under the title, and the key to the fuller account,
       flush left with the title above them */
    .macha-lede {
      max-width: 34em;
      margin: -0.4rem 0 0.5rem;
      text-align: left;
      font-family: var(--bn-display);
      font-size: 1.25rem;
      line-height: 1.6;
      color: var(--text-2);
    }

    .macha-more-line {
      margin: 0 0 2rem;
      text-align: left;
    }

    .macha-more {
      appearance: none;
      background: none;
      border: none;
      padding: 4px 2px;
      cursor: pointer;
      font-family: var(--bn-display);
      font-size: 0.98rem;
      color: var(--accent);
      background-image: linear-gradient(currentColor, currentColor);
      background-repeat: no-repeat;
      background-position: 0 100%;
      background-size: 100% 1px;
      transition: color var(--dur) ease, background-size var(--dur) var(--ease);
    }

    .macha-more:hover { color: var(--accent-hover, var(--accent)); background-size: 0% 1px; }

    .macha-more-arrow {
      display: inline-block;
      margin-left: 0.4em;
      transition: transform var(--dur) var(--ease);
    }

    .macha-more:hover .macha-more-arrow { transform: translateX(3px); }
  </style>

  <!-- the reading panel styles its injected Markdown, so they are global -->
  <style is:global>
    .macha-about {
      position: fixed;
      inset: 0;
      z-index: 120;
      pointer-events: none;
    }

    html.about-open .macha-about { pointer-events: auto; }
    html.about-open, html.about-open body { overflow: hidden; }

    .macha-about-shade {
      position: absolute;
      inset: 0;
      background: rgba(14, 26, 43, 0.32);
      backdrop-filter: blur(2px);
      -webkit-backdrop-filter: blur(2px);
      opacity: 0;
      transition: opacity 0.35s ease;
    }

    html.about-open .macha-about-shade { opacity: 1; }

    .macha-about-panel {
      position: absolute;
      top: 0;
      right: 0;
      bottom: 0;
      width: min(600px, 92vw);
      overflow-y: auto;
      overscroll-behavior: contain;
      padding: clamp(28px, 6vh, 64px) clamp(24px, 4vw, 56px) 72px;
      background: var(--surface);
      box-shadow: -24px 0 60px -30px rgba(14, 26, 43, 0.45);
      transform: translateX(100%);
      transition: transform 0.45s cubic-bezier(0.2, 0.75, 0.2, 1);
    }

    html.about-open .macha-about-panel { transform: none; }

    .macha-about-close {
      position: absolute;
      top: 14px;
      right: 14px;
      width: 40px;
      height: 40px;
      border: none;
      border-radius: 50%;
      background: none;
      font-size: 26px;
      line-height: 1;
      color: var(--text-3);
      cursor: pointer;
      transition: color 0.15s ease, background 0.15s ease;
    }

    .macha-about-close:hover { color: var(--accent); background: var(--accent-light); }

    .macha-about-title {
      margin: 0 48px 1.4rem 0;
      text-align: left;
      font-family: var(--bn-display);
      font-size: clamp(1.5rem, 2.4vw, 1.9rem);
      font-weight: 400;
      color: var(--text);
    }

    .macha-about-body {
      font-family: var(--bn-font);
      font-size: 1.06rem;
      line-height: 2;
      color: var(--text);
    }

    .macha-about-body p {
      margin: 0 0 1.1em;
      text-align: justify;
    }

    .macha-about-body > p:first-child {
      color: var(--text-2);
    }

    @media (max-width: 760px) {
      .macha-about-panel {
        width: 100%;
        padding: 64px var(--m-read-pad) 48px;
      }

      .macha-about-body {
        font-size: var(--m-read-fs);
        line-height: var(--m-read-lh);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .macha-about-shade, .macha-about-panel { transition: none; }
    }
  </style>
</Base>
