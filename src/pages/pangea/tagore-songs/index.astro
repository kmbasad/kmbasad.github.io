---
import Base from '../../../layouts/Base.astro';
import { loadSections, bnNum } from '../../../data/tagore-songs.js';

const sections = loadSections();
const total = sections.reduce((n, s) => n + s.songs.length, 0);

// roman search key: the source slug with hyphens opened back into words
const roman = (slug) => slug.replace(/-\d+$/, '').replace(/-/g, ' ');
---

<Base
  title="গীতবিতান"
  description={`রবীন্দ্রনাথ ঠাকুরের ${bnNum(total)}টি গানের সূচি — কথা, রাগ-তাল ও শ্রবণসহ।`}
  section="pangea"
  styles={['/css/tagore-songs.css']}
  navTitle="গীতবিতান"
  navParentHref="/pangea/"
  navParentLabel="প্যাঞ্জিয়া"
>
  <div class="gb-page">

    {/* The name and the search line, nothing else: the পর্যায় are the menubar
        সূচি now, and a chip row beside it was the same list twice. */}
    <header class="gb-hero">
      <h1 class="gb-title">গীতবিতান</h1>
    </header>

    <div class="gb-search">
      <div class="gb-search-row">
        <input id="gb-q" type="search" autocomplete="off" spellcheck="false"
          placeholder="প্রথম ছত্র খুঁজুন — বাংলায় বা ইংরেজি বানানে (amar sonar bangla)…"
          aria-label="গান খুঁজুন" />
        <span class="gb-count" id="gb-count">মোট {bnNum(total)}টি গান</span>
      </div>
    </div>

    {sections.map((sec) => (
      <section class="gb-section" id={sec.slug} data-sec={sec.slug} data-toc={sec.bn}>
        <div class="gb-section-head">
          <h2>{sec.bn}</h2>
          <span class="meta">{bnNum(sec.songs.length)}টি গান</span>
          <span class="grp">{sec.group}</span>
        </div>
        <div class="gb-index">
          {sec.songs.map((song, i) => (
            <a class="gb-item" href={`/pangea/tagore-songs/${song.slug}/`}
               data-t={song.title} data-r={roman(song.slug)}>
              <span class="no">{bnNum(i + 1)}</span>{song.title}
              {song.renditions.length > 0 && <span class="rec" aria-label="শ্রবণযোগ্য">♪</span>}
            </a>
          ))}
        </div>
      </section>
    ))}

    <p class="gb-empty gb-hide" id="gb-empty">কিছু পাওয়া গেল না — অন্য বানানে চেষ্টা করুন।</p>
  </div>

  <script is:inline>
    (function () {
      var q = document.getElementById('gb-q');
      var countEl = document.getElementById('gb-count');
      var emptyEl = document.getElementById('gb-empty');
      var sections = Array.prototype.slice.call(document.querySelectorAll('.gb-section'));
      var total = 0;
      sections.forEach(function (s) {
        total += s.querySelectorAll('.gb-item').length;
        /* the menubar সূচি reads data-toc; park each label so a filtered-out
           পর্যায় can drop out of the menu and come back */
        s._toc = s.getAttribute('data-toc');
      });
      var bn = function (n) {
        return String(n).replace(/\d/g, function (d) { return '০১২৩৪৫৬৭৮৯'[d]; });
      };
      function apply() {
        var query = q.value.trim();
        var qr = query.toLowerCase();
        var shown = 0;
        sections.forEach(function (sec) {
          var visible = 0;
          var items = sec.querySelectorAll('.gb-item');
          for (var i = 0; i < items.length; i++) {
            var it = items[i];
            var hit = !query ||
              it.getAttribute('data-t').indexOf(query) !== -1 ||
              it.getAttribute('data-r').indexOf(qr) !== -1;
            it.classList.toggle('gb-hide', !hit);
            if (hit) visible++;
          }
          sec.classList.toggle('gb-hide', visible === 0);
          if (visible === 0) sec.removeAttribute('data-toc');
          else sec.setAttribute('data-toc', sec._toc);
          shown += visible;
        });
        emptyEl.classList.toggle('gb-hide', shown !== 0);
        countEl.textContent = query
          ? bn(total) + 'টির মধ্যে ' + bn(shown) + 'টি'
          : 'মোট ' + bn(total) + 'টি গান';
        /* the সূচি should list only the পর্যায় still on screen */
        document.dispatchEvent(new CustomEvent('content-ready'));
      }

      var t;
      q.addEventListener('input', function () {
        clearTimeout(t);
        t = setTimeout(apply, 90);
      });
    })();
  </script>
</Base>
