---
import Base from '../../../layouts/Base.astro';
import { loadSongs, bnNum } from '../../../data/tagore-songs.js';

export function getStaticPaths() {
  return loadSongs().map((s) => ({
    params: { song: s.slug },
    props: {
      title: s.title,
      lines: s.lines,
      en: s.en || null,
      align: s.align || null,
      meta: s.meta,
      renditions: s.renditions,
      src: s.src,
      serial: s.serial,
      section: { slug: s.section.slug, bn: s.section.bn },
      prev: s.prev ? { slug: s.prev.slug, title: s.prev.title } : null,
      next: s.next ? { slug: s.next.slug, title: s.next.title } : null,
    },
  }));
}

const { title, lines, en, align, meta, renditions, src, serial, section, prev, next } =
  Astro.props;

// Split a line into word/space runs so words can be wrapped in spans while
// the whitespace (Gitabitan's indentation included) survives verbatim.
const runs = (line) => (line ? line.split(/(\s+)/).filter((r) => r !== '') : []);

// Normalised token key used for hover matching (must mirror the client JS).
const norm = (w) => w.replace(/[॥।,;:?!."'“”‘’—–()\[\]…-]/g, '').toLowerCase();

// Per-line alignment pairs, normalised: [[bnKey, [enKey, …]], …]
const alignData = (align || []).map((pairs) =>
  (pairs || []).map(([b, e]) => [norm(b), e.split(/\s+/).map(norm).filter(Boolean)])
);

const metaRows = [
  ['রাগ', meta.raga],
  ['তাল', meta.tala],
  ['রচনাকাল (বঙ্গাব্দ)', meta.writtenBn],
  ['রচনাকাল (খৃষ্টাব্দ)', meta.writtenEn],
  ['রচনাস্থান', meta.place],
  ['স্বরলিপিকার', meta.notator],
].filter(([, v]) => v);

const ytSearch =
  'https://www.youtube.com/results?search_query=' +
  encodeURIComponent(`${title} রবীন্দ্রসংগীত`);
---

<Base
  title={title}
  description={`${title} — রবীন্দ্রনাথ ঠাকুরের গান (${section.bn} ${bnNum(serial)})। কথা, ইংরেজি অনুবাদ, রাগ-তাল ও শ্রবণ।`}
  section="pangea"
  styles={['/css/tagore-songs.css', '/css/book.css']}
  navTitle={section.bn + ' ' + bnNum(serial)}
  navParentHref="/pangea/tagore-songs/"
  navParentLabel="গীতবিতান"
  navGrandParentHref="/pangea/"
  navGrandParentLabel="প্যাঞ্জিয়া"
>
  <article class={`song-page ${en ? 'song-page-wide' : ''}`}>

    {/* no in-page breadcrumb — the menubar carries গীতবিতান › পর্যায় · সংখ্যা.
        The h1 stays: it is the song's first line, which the bar's serial
        does not carry and which is the only name the song has. */}
    <h1 class="song-title">{title}</h1>

    {en ? (
      <div class="song-cols" id="song-cols">
        <div class="song-col-head">
          <span>বাংলা</span><span>English · Claude</span>
        </div>
        {lines.map((l, i) => (
          <div class="song-row" data-i={i}>
            <div class="l bn">
              {runs(l).map((r) =>
                /^\s+$/.test(r) ? r : <span class="w" data-w={norm(r)}>{r}</span>
              )}
            </div>
            <div class="l en">
              {runs((en[i] || '').trim()).map((r) =>
                /^\s+$/.test(r) ? r : <span class="w" data-w={norm(r)}>{r}</span>
              )}
            </div>
          </div>
        ))}
      </div>
    ) : (
      <div class="song-lyrics">
        {lines.map((l) => <div>{l || ' '}</div>)}
      </div>
    )}

    {metaRows.length > 0 && (
      <dl class="song-meta">
        {metaRows.map(([k, v]) => (
          <div>
            <dt class="k">{k}</dt>
            <dd class="v">{v}</dd>
          </div>
        ))}
      </dl>
    )}

    <section class="song-listen">
      <h2 class="song-listen-label">শ্রবণ</h2>
      {renditions.length > 0 ? (
        <>
          <p class="song-listen-sub">
            tagoreweb.in-এ সংকলিত পরিবেশনা — ছবিতে চাপ দিলেই গান বাজবে ·
            <a href={ytSearch} target="_blank" rel="noopener">ইউটিউবে আরও খুঁজুন</a>
          </p>
          <div class="song-rends">
            {renditions.map((r) => (
              <figure class="song-rend">
                <button class="thumb" type="button" data-yt={r.yt}
                  aria-label={`${r.artist || 'পরিবেশনা'} — গান চালান`}>
                  <img src={`https://i.ytimg.com/vi/${r.yt}/hqdefault.jpg`}
                    alt="" loading="lazy" />
                </button>
                {r.artist && <figcaption class="artist">{r.artist}</figcaption>}
              </figure>
            ))}
          </div>
        </>
      ) : (
        <p class="song-listen-empty">
          এই গানের কোনো পরিবেশনা এখনো সংকলনে যুক্ত হয়নি।<br />
          <a class="song-yt-search" href={ytSearch} target="_blank" rel="noopener">
            ইউটিউবে খুঁজে শুনুন ↗
          </a>
        </p>
      )}
    </section>

    <div class="book-nav">
      {prev
        ? <a href={`/pangea/tagore-songs/${prev.slug}/`} class="book-nav-btn book-nav-prev">
            <span class="book-nav-arrow" aria-hidden="true">←</span>&nbsp;{prev.title}
          </a>
        : <span class="book-nav-btn book-nav-disabled" aria-hidden="true">←</span>
      }
      <a href="/pangea/tagore-songs/" class="book-nav-btn book-nav-toc">সূচি</a>
      {next
        ? <a href={`/pangea/tagore-songs/${next.slug}/`} class="book-nav-btn book-nav-next">
            {next.title}&nbsp;<span class="book-nav-arrow" aria-hidden="true">→</span>
          </a>
        : <span class="book-nav-btn book-nav-disabled" aria-hidden="true">→</span>
      }
    </div>

    <p class="song-src">
      পাঠ ও পরিবেশনা-সূত্র: <a href={src} target="_blank" rel="noopener">tagoreweb.in</a> ·
      ইংরেজি অনুবাদ: Claude
    </p>
  </article>

  {en && (
    <script is:inline define:vars={{ alignData }}>
      // Hover a Bengali word → its English rendering lights up (and back).
      (function () {
        var cols = document.getElementById('song-cols');
        if (!cols) return;
        var lit = [];
        function clear() {
          lit.forEach(function (el) { el.classList.remove('hl'); });
          lit = [];
        }
        cols.addEventListener('mouseover', function (e) {
          var w = e.target.closest && e.target.closest('.w');
          if (!w) return;
          clear();
          var row = w.closest('.song-row');
          var pairs = alignData[+row.getAttribute('data-i')] || [];
          var key = w.getAttribute('data-w');
          if (!key) return;
          var fromBn = w.closest('.bn') !== null;
          var targets = {};
          pairs.forEach(function (p) {
            if (fromBn) {
              if (p[0] === key) p[1].forEach(function (k) { targets[k] = 1; });
            } else {
              if (p[1].indexOf(key) !== -1) targets[p[0]] = 1;
            }
          });
          var side = row.querySelector(fromBn ? '.en' : '.bn');
          var hits = [];
          if (side) {
            side.querySelectorAll('.w').forEach(function (el) {
              if (targets[el.getAttribute('data-w')]) hits.push(el);
            });
          }
          if (hits.length) {
            hits.concat([w]).forEach(function (el) {
              el.classList.add('hl');
              lit.push(el);
            });
          }
        });
        cols.addEventListener('mouseout', function (e) {
          if (e.target.closest && e.target.closest('.w')) clear();
        });
      })();
    </script>
  )}

  <script is:inline>
    // click-to-play: swap the thumbnail for the privacy-friendly YouTube embed
    document.addEventListener('click', function (e) {
      var btn = e.target.closest && e.target.closest('.song-rend .thumb');
      if (!btn) return;
      var iframe = document.createElement('iframe');
      iframe.src = 'https://www.youtube-nocookie.com/embed/' +
        btn.getAttribute('data-yt') + '?autoplay=1&rel=0';
      iframe.allow = 'autoplay; encrypted-media; picture-in-picture';
      iframe.allowFullscreen = true;
      iframe.title = 'YouTube player';
      btn.replaceWith(iframe);
    });
  </script>
</Base>
