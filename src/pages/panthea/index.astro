---
import Base from '../../layouts/Base.astro';
import PantheaSection from '../../components/PantheaSection.astro';
import { levelOf } from '../../data/panthea-tiers.js';

// The home is only a navigator, and exactly one screen: two halves of the
// same width on the bare page, no frames. On the left the building, summit to
// nadir; on the right the floors of the ধাপ you pressed, set out like the
// buttons of a lift. Hover a floor and its গল্প is told beneath; press it to
// go there.
//
// A গল্প's title and synopsis are its Markdown's frontmatter
//   ---
//   title: …
//   synopsis: …
//   ---
// in src/stories/panthea/<minar|patal>/<n>.md (a পাতাল floor by its number
// without the minus). A floor that has one is lit.
const mods = import.meta.glob('../../stories/panthea/**/*.md', { eager: true });
const stories = {};
for (const [path, mod] of Object.entries(mods)) {
  const m = path.match(/panthea\/(minar|patal)\/(\d+)\.md$/);
  if (!m) continue;
  const level = levelOf(m[1], Number(m[2]));
  const fm = (mod as any).frontmatter ?? {};
  stories[level] = { title: fm.title ?? '', synopsis: fm.synopsis ?? '' };
}

/* Behind the navigator, faint: Mondrian's "Broadway Boogie Woogie"
   (1942-43), his city of yellow streets studded with small red, blue and
   grey blocks, a few larger blocks between them. A tower is a city stood on
   end, so the building stands in one. Seeded, the same on every visit. */
const BBW = (() => {
  let h = 1942;
  const rnd = () => ((h = (h * 1103515245 + 12345) % 2147483648) / 2147483648);
  const Yel = '#efd03c', Red = '#c8302c', Blu = '#2a4f9c', Gry = '#cfccc4';
  const studs = [Red, Blu, Gry, Red, Gry];
  const out = [];
  const xs = Array.from({ length: 11 }, (_, i) => 3 + i * 9.4 + (rnd() - 0.5) * 3);
  const ys = Array.from({ length: 8 }, (_, i) => 4 + i * 13 + (rnd() - 0.5) * 4);
  for (const x of xs) {
    out.push({ x, y: 0, w: 1.1, h: 100, c: Yel });
    for (let y = rnd() * 4; y < 100; y += 2.5 + rnd() * 5)
      if (rnd() < 0.55) out.push({ x, y, w: 1.1, h: 1.6, c: studs[Math.floor(rnd() * studs.length)] });
  }
  for (const y of ys) {
    out.push({ x: 0, y, w: 100, h: 1.6, c: Yel });
    for (let x = rnd() * 3; x < 100; x += 1.8 + rnd() * 3.5)
      if (rnd() < 0.5) out.push({ x, y, w: 0.9, h: 1.6, c: studs[Math.floor(rnd() * studs.length)] });
  }
  for (let k = 0; k < 9; k++) {
    const x = xs[Math.floor(rnd() * (xs.length - 1))] + 1.8, y = ys[Math.floor(rnd() * (ys.length - 1))] + 2.6;
    const w = 3 + rnd() * 4, hh = 4 + rnd() * 5;
    out.push({ x, y, w, h: hh, c: [Red, Blu, Yel][k % 3] });
    out.push({ x: x + w * 0.3, y: y + hh * 0.3, w: w * 0.4, h: hh * 0.4, c: [Gry, Yel, Red][k % 3] });
  }
  return out.map((r) => ({ ...r, x: +r.x.toFixed(2), y: +r.y.toFixed(2), w: +r.w.toFixed(2), h: +r.h.toFixed(2) }));
})();
---

<Base
  title="প্যান্থিয়া"
  description="প্যান্থিয়া: মহাসমুদ্রের দ্বীপে এক ইমারত, মাটির ওপরে সাতশো তলা আর নিচে সাতশো, চূড়া থেকে তলদেশ পর্যন্ত।"
  section="panthea"
  bodyClass="panthea-page pn-home-page"
  styles={['/css/panthea.css']}
  navTitle="প্যান্থিয়া"
>
  <!-- The home is the roof, one step above তলা ৭০০ — so its gilt key carries
       a single ↓ and no ↑. -->
  <Fragment slot="nav-here">
    <span class="nav-cur">প্যান্থিয়া</span>
    <a class="pn-nav-arrow" href="/panthea/minar/700/" title="তলা ৭০০ · ctrl+↓"
       aria-label="তলা ৭০০">↓</a>
  </Fragment>

  <div class="pn-home">
    <svg class="pn-bbw" viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
      {BBW.map((r) => <rect x={r.x} y={r.y} width={r.w} height={r.h} fill={r.c} />)}
    </svg>
    <section class="pn-half pn-half--building" aria-label="প্যান্থিয়া">
      <PantheaSection variant="map" />
    </section>

    <section class="pn-half pn-half--lift">
      <header class="pn-lift-head">
        <h1 class="pn-title">প্যান্থিয়া</h1>
        <h2 class="pn-lift-name"></h2>
        <p class="pn-lift-meta"></p>
      </header>
      <nav class="pn-lift" aria-label="তলা"></nav>
      <!-- what the floor under the pointer holds; at rest, the ধাপ's own line -->
      <div class="pn-say" aria-live="polite">
        <p class="pn-say-floor"></p>
        <p class="pn-say-title"></p>
        <p class="pn-say-syn"></p>
      </div>
    </section>
  </div>

  <script is:inline type="application/json" id="pn-stories" set:html={JSON.stringify(stories)}></script>

  <script>
    import {
      toBn,
      towerSegments,
      patalSegments,
      levelOf,
      levelNum,
      levelHref,
      levelTitle,
      levelKind,
      levelFloor,
      floorMetres,
      glyphY,
      glyphHalf,
      GLYPH,
    } from '../../data/panthea-tiers.js';
    import { mondrian, klee, luma } from '../../data/lift-paintings.js';

    const stories = JSON.parse(document.getElementById('pn-stories')?.textContent || '{}');
    const $ = (s, r = document) => r.querySelector(s);

    const map = $('.pn-section--map');
    const bands = [...map.querySelectorAll('.pn-band')];
    const probe = $('.pn-probe', map);
    const lift = $('.pn-lift');
    const head = { name: $('.pn-lift-name'), meta: $('.pn-lift-meta') };
    const say = {
      box: $('.pn-say'), floor: $('.pn-say-floor'),
      title: $('.pn-say-title'), syn: $('.pn-say-syn'),
    };
    let rest = '';                   // what the caption says when nothing is hovered
    const phone = matchMedia('(max-width: 760px)');

    // the 28 ধাপ in the order the building stands: summit down to nadir
    const ORDER = [
      ...towerSegments.map((s) => `t${s.index}`).reverse(),
      ...patalSegments.map((s) => `u${s.index}`),
    ];
    const segOf = (key) => {
      const patal = key[0] === 'u';
      return { patal, kind: patal ? 'patal' : 'minar',
               seg: (patal ? patalSegments : towerSegments)[Number(key.slice(1)) - 1] };
    };

    let current = null;

    // ── the lift panel ──
    // Every ধাপ is a hundred floors, so every panel is ten by ten: one row per
    // ten floors, the last digit always in the same column, as on a lift's
    // buttons. Up the tower the highest row is on top; down the পাতাল the
    // shallowest is, as the floors themselves lie. On a phone the buttons are
    // small, so a পাতাল button drops its minus (the heading says পাতাল, and
    // the button's label keeps the full name).
    const draw = (key) => {
      current = key;
      const { patal, kind, seg } = segOf(key);
      const cols = 10;
      const bare = phone.matches && patal;

      head.name.textContent = seg.bn;
      head.meta.textContent = `${seg.floorsLabel} · ${seg.metresBn} ${patal ? 'নিচে' : 'উপরে'}`;
      let lit = 0;
      for (let f = seg.floors[0]; f <= seg.floors[1]; f++)
        if (stories[levelOf(kind, f)]) lit++;
      rest = lit ? `${toBn(lit)}টি গল্প লেখা হয়েছে` : 'এই ধাপের গল্প এখনো লেখা হয়নি';
      quiet();

      const group = (f) => Math.floor((f - 1) / cols);
      const g0 = group(seg.floors[0]), g1 = group(seg.floors[1]);
      const rows = g1 - g0 + 1;
      const digits = Math.max(...[seg.floors[0], seg.floors[1]].map((f) => levelNum(levelOf(kind, f)).length));
      lift.style.setProperty('--cols', String(cols));
      lift.style.setProperty('--rows', String(rows));
      lift.dataset.digits = String(digits);

      // the lights come on the way the building runs: up from the ground in
      // the tower, down from it in the পাতাল
      let html = '';
      for (let f = seg.floors[0]; f <= seg.floors[1]; f++) {
        const level = levelOf(kind, f);
        const row = patal ? group(f) - g0 + 1 : g1 - group(f) + 1;
        const col = ((f - 1) % cols) + 1;
        const wave = (group(f) - g0) * 34 + (col - 1) * 9;
        html += `<a class="pn-lift-btn${stories[level] ? ' pn-lit' : ''}" href="${levelHref(level)}"`
              + ` data-level="${level}" style="grid-row:${row};grid-column:${col};--wake:${wave}ms"`
              + ` aria-label="${levelTitle(level)}">${bare ? toBn(f) : levelNum(level)}</a>`;
      }
      lift.innerHTML = html;

      // paint it: each cell its colour, the number in whichever of black or
      // white reads on it
      const cells = patal ? klee(key, seg.index - 1) : mondrian(key);
      lift.dataset.painter = patal ? 'klee' : 'mondrian';
      [...lift.children].forEach((btn) => {
        const f = Math.abs(Number(btn.dataset.level));
        const row = Math.floor((f - 1) / 10) - g0, col = (f - 1) % 10;
        // cells are painted in the panel's own reading order, top row first
        const r = patal ? row : g1 - g0 - row;
        const c = cells[r * 10 + col];
        btn.style.background = c;
        btn.style.color = luma(c) > 150 ? '#141518' : '#f6f4ee';
      });
      size();

      bands.forEach((b) => b.classList.toggle('pn-sel', b.dataset.key === key));
    };

    // the buttons are round, so their size is the smaller of a cell's two
    // sides — and a hundred of them must fit the half without a scroll
    // — the heading, the grid and the caption travel as one group, centred
    // against the building, so the grid's room is what the half has left
    const half = $('.pn-half--lift');
    const size = () => {
      const r = half.getBoundingClientRect();
      const room = r.height - $('.pn-lift-head').offsetHeight - say.box.offsetHeight - 48;
      const cols = Number(lift.style.getPropertyValue('--cols'));
      const rows = Number(lift.style.getPropertyValue('--rows'));
      // the painting's own lines and edge take room too: measure them
      const cs = getComputedStyle(lift);
      const gap = parseFloat(cs.columnGap) || 0, pad = parseFloat(cs.paddingLeft) || 0;
      const across = r.width - 2 * pad - gap * (cols - 1);
      const down = room - 2 * pad - gap * (rows - 1);
      const cell = Math.floor(Math.max(20, Math.min(60, across / cols, down / rows)));
      lift.style.setProperty('--cell', `${cell}px`);
    };

    // the building's scale is set in the same type size as everything on the
    // right, whatever size the drawing is drawn at: its font is given in the
    // drawing's own units, so it is re-reckoned from the drawn height
    const FS = 12.5;                 // px — keep in step with --pn-fs-small
    const scaleType = () => {
      const vb = map.viewBox.baseVal;
      const k = map.getBoundingClientRect().height / vb.height;
      if (k) map.style.setProperty('--pn-unit-fs', String(FS / k));
    };

    // ── a floor's গল্প, told beneath the buttons before you go ──
    function quiet() {
      lift.querySelector('.pn-armed')?.classList.remove('pn-armed');
      probe.classList.remove('on');
      say.box.classList.remove('pn-say--floor');
      say.floor.textContent = '';
      say.title.textContent = '';
      say.syn.textContent = rest;
    }

    const showCard = (btn) => {
      const level = Number(btn.dataset.level);
      const s = stories[level];
      say.box.classList.add('pn-say--floor');
      say.floor.textContent = levelTitle(level);
      say.title.textContent = s ? (s.title || '') : '';
      say.syn.textContent = s ? s.synopsis : 'এই তলার গল্প এখনো লেখা হয়নি।';
      say.box.classList.toggle('pn-say--empty', !s);

      // and on the building, a gold line at that floor's own height
      const kind = levelKind(level), m = floorMetres(kind, levelFloor(level));
      const y = String(glyphY(kind, m)), h = glyphHalf(kind, m) + 6;
      probe.setAttribute('x1', String(GLYPH.CX - h));
      probe.setAttribute('x2', String(GLYPH.CX + h));
      probe.setAttribute('y1', y);
      probe.setAttribute('y2', y);
      probe.classList.add('on');
    };
    const hideCard = quiet;

    lift.addEventListener('pointerover', (e) => {
      const btn = e.target.closest('.pn-lift-btn');
      if (btn && e.pointerType !== 'touch') showCard(btn);
    });
    lift.addEventListener('pointerleave', (e) => e.pointerType !== 'touch' && hideCard());
    lift.addEventListener('focusin', (e) => {
      const btn = e.target.closest('.pn-lift-btn');
      if (btn) showCard(btn);
    });
    // a mouse goes straight to the floor; a finger reads the card first and
    // goes on the second press
    let touch = false;
    lift.addEventListener('pointerdown', (e) => (touch = e.pointerType === 'touch'));
    lift.addEventListener('click', (e) => {
      const btn = e.target.closest('.pn-lift-btn');
      if (!btn || !touch || btn.classList.contains('pn-armed')) return;
      e.preventDefault();
      hideCard();
      showCard(btn);
      btn.classList.add('pn-armed');
    });

    // ── the building: press a ধাপ ──
    const choose = (key) => {
      if (!ORDER.includes(key)) return;
      draw(key);
      history.replaceState(null, '', `#${key}`);
    };
    bands.forEach((b) => b.addEventListener('click', () => choose(b.dataset.key)));

    // plain ↑ / ↓ walk the ধাপ the way the building stands; ctrl+↓ still
    // drops to তলা ৭০০, as from any roof
    document.addEventListener('keydown', (e) => {
      if (e.altKey || e.metaKey) return;
      if (e.target.closest?.('input, textarea, [contenteditable]')) return;
      if (e.key === 'Escape') return hideCard();
      if (e.ctrlKey) {
        if (e.key !== 'ArrowDown') return;
        e.preventDefault();
        location.href = '/panthea/minar/700/';
        return;
      }
      const d = e.key === 'ArrowUp' ? -1 : e.key === 'ArrowDown' ? 1 : 0;
      if (!d) return;
      e.preventDefault();
      const i = ORDER.indexOf(current);
      choose(ORDER[Math.min(ORDER.length - 1, Math.max(0, i + d))]);
    });

    const fromHash = location.hash.slice(1);
    draw(ORDER.includes(fromHash) ? fromHash : 't1');
    // a link to /panthea/#u3 from a floor's inset, followed while already here
    window.addEventListener('hashchange', () => {
      const key = location.hash.slice(1);
      if (ORDER.includes(key) && key !== current) draw(key);
    });
    new ResizeObserver(() => size()).observe(half);
    new ResizeObserver(scaleType).observe(map);
    phone.addEventListener('change', () => draw(current));
  </script>
</Base>
