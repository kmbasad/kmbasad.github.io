---
// The 1000 underworld floors — /panthea/patal/1/ … /panthea/patal/1000/
import PantheaFloor from '../../../components/PantheaFloor.astro';
import { patalSegmentOf } from '../../../data/panthea-tiers.js';

export function getStaticPaths() {
  return Array.from({ length: 1000 }, (_, i) => ({
    params: { floor: String(i + 1) },
  }));
}

const floor = Number(Astro.params.floor);
const segment = patalSegmentOf(floor);
---

<PantheaFloor kind="patal" floor={floor} segment={segment} />
