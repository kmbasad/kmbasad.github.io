---
// The colophon: the foot of every page but the home (Base renders it, last in
// <body>). A broad dark field closing the page the way the masthead opens it:
// the selvedge of the painting along its top edge, then the site's name and
// a few words about it, the five rooms each with its gloss, and the author:
// his name, the ways to reach him, the licence.
import { AUTHOR_EN, LICENSE, DECLARATION } from '../data/site.js';
import { ROOMS, SITE_NAME, SITE_ABOUT } from '../data/rooms.js';
import { UI } from '../data/ui.js';

const STRIP = [
  ['sage', 6], ['cream', 9], ['blue', 17], ['pink', 5], ['lav', 11], ['ochre', 8], ['clay', 4],
  ['blue', 4], ['cream', 4], ['pink', 12], ['clay', 6], ['sage', 7], ['lav', 5], ['ochre', 3],
];
const CONTACT = [
  { href: 'mailto:khanmuhammadbinasad@gmail.com', label: 'khanmuhammadbinasad@gmail.com' },
  { href: 'https://www.facebook.com/kmbasad', label: 'Facebook' },
];
---

<footer class="colophon">
  <div class="selvedge" aria-hidden="true">
    {STRIP.map(([c, w]) => <span class={`sv-${c}`} style={`flex-grow:${w}`}></span>)}
  </div>

  <div class="colo-inner">
    <div class="colo-about">
      <a class="colo-name" href="/">{SITE_NAME}</a>
      <p>{SITE_ABOUT}</p>
    </div>

    <nav class="colo-rooms" aria-label={UI.sections}>
      {ROOMS.map((r) => (
        <a class={`colo-room room-${r.tint}`} href={r.href}>
          <span class="colo-room-name">{r.label}</span>
          <span class="colo-room-gloss">{r.gloss}</span>
        </a>
      ))}
    </nav>

    <ul class="colo-contact">
      <li class="colo-author">{AUTHOR_EN}</li>
      {CONTACT.map((c) => <li><a href={c.href}>{c.label}</a></li>)}
      <li class="colo-declare">{DECLARATION}</li>
      <li class="colo-license"><a href={LICENSE.href} rel="license">{LICENSE.name}</a></li>
    </ul>
  </div>

</footer>
