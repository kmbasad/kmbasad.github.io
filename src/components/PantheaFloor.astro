---
// One floor of Panthea: TALA 1 to 700 up the tower, -1 to -700 down beneath
// it. There is no zero floor.
// The page is the story, in one reading column with its headline, and beside
// it the building in section, small (the home page's navigator), your DHAP
// lit and your floor a hairline across it. The rail carries where you are:
// the DHAP with its arrows, its hundred floors as a lift's buttons, and the
// story's contents.
import Base from '../layouts/Base.astro';
import PantheaSection from './PantheaSection.astro';
import {
  toBn,
  levelOf,
  levelHref,
  levelTitle,
  levelAdd,
  LEVEL_MAX,
  LEVEL_MIN,
} from '../data/panthea-tiers.js';

interface Props {
  kind: 'minar' | 'patal';
  floor: number;
  segment: any;
}

const { kind, floor, segment } = Astro.props;

// the few words this page says of itself
const W = {
  panthea: 'প্যান্থিয়া',
  stub: '\u098f\u0987 \u0997\u09b2\u09cd\u09aa \u098f\u0996\u09a8\u09cb \u09b2\u09c7\u0996\u09be \u09b9\u09af\u09bc\u09a8\u09bf\u0964',
};

// -- Story (optional per-floor markdown) --
// A floor's story lives at src/stories/panthea/<level>.md, named by the floor's
// signed number (1.md, -5.md); its frontmatter title and synopsis are the
// page's headline and standfirst. No file -> the stub line. In dev it is
// editable in place like every other text on the site (see astro.config.mjs).
const stories = import.meta.glob('../stories/panthea/**/*.md', { eager: true });
const storyKey = `${kind === 'patal' ? -floor : floor}.md`;
const mod = stories[`../stories/panthea/${storyKey}`] as any;
const Story = mod?.Content ?? null;
const fm = mod?.frontmatter ?? {};
const editSrc = import.meta.env.DEV ? storyKey : null;

const level = levelOf(kind, floor);
const titleBn = levelTitle(level);
// One step along the axis, the missing zero skipped; the Panthea home is the roof.
const step = (l, d) => {
  if (d > 0 && l === LEVEL_MAX) return { href: levelHref(LEVEL_MAX + 1), bn: levelTitle(LEVEL_MAX + 1) };
  if (d < 0 && l === LEVEL_MIN) return null;
  const to = levelAdd(l, d);
  return { href: levelHref(to), bn: levelTitle(to) };
};
const up = step(level, 1);
const down = step(level, -1);

const segKey = `${kind === 'patal' ? 'u' : 't'}${segment.index}`;
const segDot = `pn-dot-${segKey}`;
---

<Base
  rail
  description={`${W.panthea} ${titleBn}${fm.title ? ': ' + fm.title : ''}`}
  section="panthea"
  bodyClass="panthea-page"
  footPrev={down?.href ?? null}
  footNext={up?.href ?? null}
  prevLabel={down?.bn}
  nextLabel={up?.bn}
  styles={['/css/panthea.css']}
  navTitle={titleBn}
  navParentHref="/panthea/"
  navParentLabel={W.panthea}
>
  <!-- in the rail's path: the DHAP, a step between Panthea and the floor -->
  <li slot="rail-crumbs" class="pn-rail" data-seg={segKey}>
    <a class="rail-crumb pn-seg-name" href={`/panthea/#${segKey}`}>
      <span class:list={['pn-seg-dot', segDot]} aria-hidden="true"></span>
      <span class="pn-seg-key-name">{segment.bn}</span>
    </a>
  </li>

  <div class="pn-page" data-level={level}>
    <!-- where you are: the home's navigator, small, beside the story -->
    <aside class="pn-inset">
      <PantheaSection variant="inset" level={level} />
    </aside>

    <header class="pn-head">
      <p class="pn-kicker">
        <span class:list={['pn-seg-dot', segDot]} aria-hidden="true"></span>
        <span>{titleBn}</span>
      </p>
      <h1 class="pn-title">{fm.title || titleBn}</h1>
      {fm.synopsis && <p class="pn-standfirst">{fm.synopsis}</p>}
    </header>

    <!-- data-toc-scan: site.js stamps these headings and lists them in the
         rail's contents. No headings (an unwritten floor), no contents. -->
    <article class="pn-story pn-prose" data-md={editSrc} data-toc-scan="h2, h3">
      {Story
        ? <Story />
        : <p class="pn-story-empty">{W.stub}</p>}
    </article>
  </div>

  <script>
    // -- The elevator: ctrl+up / ctrl+down --
    // One tap steps a floor; hold and the car accelerates and keeps running,
    // 1400 stops on one axis, straight from the top into the other world.
    // A page load per floor would be unridable, so the ride is scrubbed in
    // place (the name in the rail, the DHAP and its lift, the inset's lit band
    // and hairline all redraw from the same functions the build used) and
    // only the floor you let go on is actually navigated to.
    import {
      toBn,
      GLYPH,
      LEVEL_MAX,
      LEVEL_MIN,
      levelAdd,
      floorMetres,
      glyphY,
      glyphHalf,
      levelKind,
      levelFloor,
      levelHref,
      levelTitle,
      levelSegment,
      towerSegments,
      patalSegments,
    } from '../data/panthea-tiers.js';

    const page = document.querySelector('.pn-page');
    const railBox = document.querySelector('.pn-rail');
    if (page && railBox) {
      const START = Number(page.dataset.level);
      const R = (n) => Math.round(n * 10) / 10;
      const q = (sel) => document.querySelector(sel);
      const el = {
        title: q('.rail-title'),
        bands: [...document.querySelectorAll('.pn-inset .pn-band')],
        hair: q('.pn-inset .pn-hair'),
        segLink: q('.pn-seg-name'),
        segName: q('.pn-seg-key-name'),
        keyDot: q('.pn-seg-name .pn-seg-dot'),
      };
      let level = START;
      let raf = 0, holdTimer = 0, dir = 0;

      // the inset is the home's navigator drawn small: a DHAP pressed here
      // opens the home on that DHAP, cut open, every floor drawn
      el.bands.forEach((band) =>
        band.addEventListener('click', () => {
          location.href = `/panthea/#${band.dataset.key}`;
        }));

      // -- the DHAP in the rail's path, following the ride across worlds --
      const paintSeg = () => {
        const seg = levelSegment(level);
        const key = `${level > 0 ? 't' : 'u'}${seg.index}`;
        el.segName.textContent = seg.bn;
        el.keyDot.className = `pn-seg-dot pn-dot-${key}`;
        el.segLink.href = `/panthea/#${key}`;
      };

      // -- the inset: move the lit band and the hairline --
      const draw = () => {
        const kind = levelKind(level), floor = levelFloor(level);
        const seg = levelSegment(level);
        const key = `${level > 0 ? 't' : 'u'}${seg.index}`;

        if (el.title) el.title.textContent = levelTitle(level);
        el.bands.forEach((b) => b.classList.toggle('pn-here', b.dataset.key === key));
        paintSeg();

        const m = floorMetres(kind, floor);
        const y = String(R(glyphY(kind, m))), h = R(glyphHalf(kind, m));
        el.hair.setAttribute('x1', String(R(GLYPH.CX - h)));
        el.hair.setAttribute('x2', String(R(GLYPH.CX + h)));
        el.hair.setAttribute('y1', y);
        el.hair.setAttribute('y2', y);
      };

      const stepTo = (next) => {
        const clamped = Math.min(LEVEL_MAX, Math.max(LEVEL_MIN, next));
        if (clamped === level) return false;
        level = clamped;
        draw();
        return true;
      };

      // the car: eases from a floor every 140 ms up to ~120 a second, so a
      // short hold browses the neighbourhood and a long one crosses worlds
      const ride = () => {
        const t0 = performance.now();
        let prev = t0, carry = 0;
        const tick = (now) => {
          const p = Math.min(1, (now - t0) / 2200);
          carry += (7 + 113 * p * p) * ((now - prev) / 1000);
          prev = now;
          const whole = Math.floor(carry);
          if (whole) {
            carry -= whole;
            if (!stepTo(levelAdd(level, dir * whole))) return (raf = 0);  // hit an end
          }
          raf = requestAnimationFrame(tick);
        };
        document.body.classList.add('pn-riding');
        raf = requestAnimationFrame(tick);
      };

      const arrive = () => {
        clearTimeout(holdTimer);
        cancelAnimationFrame(raf);
        holdTimer = raf = dir = 0;
        if (level !== START) location.href = levelHref(level);
        else document.body.classList.remove('pn-riding');
      };

      document.addEventListener('keydown', (e) => {
        if (!e.ctrlKey || e.altKey || e.metaKey) return;
        const d = e.key === 'ArrowUp' ? 1 : e.key === 'ArrowDown' ? -1 : 0;
        if (!d) return;
        if (e.target.closest?.('input, textarea, [contenteditable]')) return;
        e.preventDefault();
        if (dir) return;                       // already engaged — swallow key-repeat
        dir = d;
        // the roof sits one step above the top floor, as the ↑ link does
        if (d === 1 && level === LEVEL_MAX) return void (location.href = levelHref(LEVEL_MAX + 1));
        stepTo(levelAdd(level, d));
        holdTimer = window.setTimeout(ride, 260);
      });

      document.addEventListener('keyup', (e) => {
        if (dir && (e.key === 'ArrowUp' || e.key === 'ArrowDown' || e.key === 'Control')) arrive();
      });
      window.addEventListener('blur', () => dir && arrive());
    }
  </script>
</Base>
