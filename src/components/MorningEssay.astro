---
/* One morning essay, in the reading voice, on its shelf in মাচা. The
   headline is the site's one pattern: the morning's date as the kicker, the
   essay's title, and as the standfirst the book and the passage it reads;
   under them the credit, that this is Claude's English essay in Bangla. The
   rail carries the way to the mornings before and after. */
import Base from '../layouts/Base.astro';
import { mornings, bnDate, ESSAY_W, ESSAYS_BASE } from '../data/mornings.js';

const { slug } = Astro.props;
const at = mornings.findIndex((m) => m.slug === slug);
const m = mornings[at];
const fm = m.fm;
const Content = m.Content;
// newest first: the previous reading is the older morning
const older = mornings[at + 1];
const newer = mornings[at - 1];
const editSrc = import.meta.env.DEV ? `${slug}.md` : null;
---

<Base rail section="trellises" bodyClass="essay-page" styles={['/css/essay.css']}
  description={`${ESSAY_W.name}, ${bnDate(slug)}: ${fm.title}`}
  navTitle={fm.title} navParentHref={ESSAYS_BASE} navParentLabel={ESSAY_W.name}
  navGrandParentHref="/trellises/" navGrandParentLabel="মাচা"
  footPrev={older ? `${ESSAYS_BASE}${older.slug}/` : null} prevLabel={older?.fm.title}
  footNext={newer ? `${ESSAYS_BASE}${newer.slug}/` : null} nextLabel={newer?.fm.title}
>
  <div class="es-page">
    <header class="es-head">
      <p class="es-kicker"><time datetime={slug}>{bnDate(slug)}</time></p>
      <h1 class="es-title">{fm.title}</h1>
      {fm.reads && <p class="es-standfirst"><span class="es-reads">{ESSAY_W.reads}</span> {fm.reads}</p>}
      <p class="es-credit">{ESSAY_W.credit}</p>
    </header>

    <article class="es-prose" data-md={editSrc} data-toc-scan="h2, h3">
      <Content />
    </article>
  </div>
</Base>
