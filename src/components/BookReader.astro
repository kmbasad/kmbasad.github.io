---
/**
 * BookReader.astro — the shared shell of every Translations reading page.
 *
 * Two panes under the menubar, in the manner of the books workshop:
 *   · left — the parallel text (বাংলা · মূল · #), fed by md-loader.js +
 *     translation-table.js into the empty .tt-table, scrolling on its own
 *     (data-page-scroll: the menubar reads this column's scroll);
 *   · right — the শব্দকোষ: click any source-language word and book.js
 *     fetches its meaning from Wiktionary into this panel, with links out
 *     to the classic dictionaries of that language.
 *
 * Word-hover cross-highlighting between the Bangla and the source is
 * translation-table.js, unchanged. No image panel — the plates will
 * return in another form later. The page's title is its own again: on
 * a phone it opens the page, on a wide screen it stands upright beside the
 * text like a book's spine (`title`, `work`); the menubar keeps the trail
 * and the contents key.
 *
 * Props: `title`, `work`, and `config`, which becomes window.TRANS_CONFIG (src, dict?,
 * dictLang, meters?, marginSections?, tocStyle?, toc/prev/next…).
 */
interface Props {
  config: Record<string, unknown>;
  title?: string;     // this part's name (the same the menubar carries)
  work?: string;      // the work it belongs to
}
const { config, title, work } = Astro.props;
import MondrianEdge from './MondrianEdge.astro';
---

<!-- the dictionary starts folded on every visit: fold it before first
     paint so it never flashes open (book.js keeps it so until a lookup) -->
<script is:inline>document.body.classList.add('dict-collapsed');</script>

<div class="book-layout">
  <div class="book-text-panel" data-page-scroll>
    <div class="book-text-body">
      <!-- The page's own title. On a phone it opens the page, compact; on a
           wide screen it stands upright in a narrow column of its own at the
           text's left, like the name on a book's spine, and stays in view as
           the poem scrolls (book.css). -->
      {title && (
        <header class="book-spine">
          {work && <span class="book-spine-work">{work}</span>}
          <h1 class="book-spine-title">{title}</h1>
        </header>
      )}
      <table class="tt-table">
        <tbody></tbody>
      </table>
    </div>
  </div>

  <!-- Desktop: drag this seam to resize the শব্দকোষ (book.js); double-click
       it to restore the default width. -->
  <div class="book-dict-grip" id="book-dict-grip" role="separator" aria-orientation="vertical"
       aria-label="শব্দকোষের প্রস্থ" tabindex="0" title="টেনে প্রস্থ বদলান · দুই ক্লিকে আগের মাপ"></div>

  <aside class="book-dict" id="book-dict" aria-label="শব্দকোষ">
    <div class="dict-inner">
      <div class="dict-top">
        <span class="dict-kicker">শব্দকোষ</span>
        <button class="dict-close" id="dict-close" type="button" aria-label="শব্দকোষ গুটিয়ে রাখুন" title="গুটিয়ে রাখুন">×</button>
      </div>
      <h2 class="dict-word" id="dict-word">অভিধান</h2>
      <p class="dict-hint" id="dict-hint">মূল পাঠের যেকোনো শব্দে ক্লিক করুন — অর্থ এখানে আসবে।</p>
      <div class="dict-body" id="dict-body"></div>
      <nav class="dict-links" id="dict-links" hidden aria-label="বাইরের অভিধান"></nav>
    </div>
  </aside>

  <!-- Desktop: the folded panel's tab on the page's right edge — press it to
       open the শব্দকোষ again. -->
  <button class="dict-reopen" id="dict-reopen" type="button" aria-label="শব্দকোষ খুলুন" hidden>
    <span>শব্দকোষ</span>
  </button>
</div>

<!-- a sparing Mondrian at the screen's edges -->
<MondrianEdge seed={`book-${title ?? ''}`} />

<script is:inline define:vars={{ config }}>
  window.TRANS_CONFIG = config;
</script>
<script is:inline src="/js/md-loader.js"></script>
<script is:inline src="/js/translation-table.js"></script>
<script is:inline src="/js/book.js"></script>
{/* dev-server only: Ctrl+double-click a বাংলা line to edit it in place —
    the endpoint and script exist solely inside `npm run dev` */}
