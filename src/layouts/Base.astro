---
import NavChevron from '../components/NavChevron.astro';
import SiteFoot from '../components/SiteFoot.astro';

interface Props {
  title?: string;
  description?: string;
  section?: 'panthea' | 'pangea' | 'translations' | 'trellises' | '';
  bodyClass?: string;
  styles?: string[];
  navTitle?: string;            // page name shown on the right of the nav bar
  navParentHref?: string;       // breadcrumb parent URL
  navParentLabel?: string;      // breadcrumb parent label
  navGrandParentHref?: string;  // optional grandparent URL
  navGrandParentLabel?: string; // optional grandparent label
  tocStyle?: '' | 'grid';       // সূচি shape: a list of names, or a grid of numbers
  footPrev?: string | null;     // the foot's ← (dimmed when absent)
  footNext?: string | null;     // the foot's →
}

const {
  title = '',
  description = 'যৌথ অচেতন — খান মুহাম্মদ বিন আসাদ: প্যান্থিয়া, প্যাঞ্জিয়া, অনুবাদ, মাচা।',
  section = '',
  bodyClass = '',
  styles = [],
  navTitle = '',
  navParentHref = '',
  navParentLabel = '',
  navGrandParentHref = '',
  navGrandParentLabel = '',
  tocStyle = '',
  footPrev = null,
  footNext = null,
} = Astro.props;

const isHome = Astro.url.pathname === '/';

/* The tab title is the page's whole breadcrumb read outward, ending at the
   site's name: title/h1 — parent — grandparent — যৌথ অচেতন. Pages with a
   breadcrumb derive it from their nav props; pages without one pass `title`
   (their h1); home passes nothing and gets the bare site name. */
const SITE_NAME = 'যৌথ অচেতন';
const crumbChain = navTitle ? [navTitle, navParentLabel, navGrandParentLabel] : [title];
const pageTitle = crumbChain
  .filter(Boolean)
  .filter((s) => s !== SITE_NAME)
  .concat(SITE_NAME)
  .join(' — ');

/* হোম is not a link here — the mark is the way home. */
const links = [
  { href: '/panthea/',     label: 'প্যান্থিয়া', gloss: 'গদ্যকবিতায় লেখা গল্পের ধারা', active: section === 'panthea' },
  { href: '/pangea/',      label: 'প্যাঞ্জিয়া', gloss: 'বাংলা সাহিত্যের আর্কাইভ',      active: section === 'pangea' },
  { href: '/translations/',label: 'অনুবাদ',     gloss: 'বিশ্বসাহিত্যের বাংলা অনুবাদ',  active: section === 'translations' },
  { href: '/trellises/',   label: 'মাচা',       gloss: 'চিন্তার মাচায় লেখা প্রবন্ধ',   active: section === 'trellises' },
];

/* Each room wears its own tint from the home page's painting, in the bar
   and in the phone sheet alike; the chosen room wears the deeper one. */
const TINTS = { '/panthea/': 'blue', '/pangea/': 'pink', '/translations/': 'ochre', '/trellises/': 'sage' };

/* The breadcrumb's ancestors, outermost first, from the section root: the
   page's half of the bar reads as a whole trail (প্যান্থিয়া › ধাপ ৩ › তলা
   ২৫১), apart from the site's half where the same section is a room. */
const ancestors = [
  { href: navGrandParentHref, label: navGrandParentLabel },
  { href: navParentHref,      label: navParentLabel },
].filter((a) => a.href && a.label);

/* The mark — the same graduated limb the home page prints large, cut down to
   an eight-division rose with the zenith dot at its head — the identical
   drawing the favicon carries, so the tab and the bar are one mark. Three
   sizes: this, the watermark behind the menu sheet, and the home plate. */
const markTicks = Array.from({ length: 8 }, (_, i) => {
  const rad = (i * 45 - 67.5) * Math.PI / 180;
  return {
    x1: (50 + 33 * Math.cos(rad)).toFixed(2), y1: (50 + 33 * Math.sin(rad)).toFixed(2),
    x2: (50 + 22 * Math.cos(rad)).toFixed(2), y2: (50 + 22 * Math.sin(rad)).toFixed(2),
  };
});
---

<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#ebeff6" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    <!-- Bangla type: Noto Serif Bengali for every word on the site, Tiro Bangla for the menubar alone -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Serif+Bengali:wght@300;400;500;600;700&family=Tiro+Bangla:ital@0;1&display=swap"
    />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate icon" href="/favicon-32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <link rel="stylesheet" href="/css/style.css" />
    {styles.map((href) => <link rel="stylesheet" href={href} />)}

    <script is:inline defer src="/js/site.js"></script>
    {/* dev only: Ctrl+click any text to edit it in place (src/dev/edit.js) */}
    {import.meta.env.DEV && <script is:inline defer src="/__edit/edit.js"></script>}

    <slot name="head" />
  </head>

  <body class={bodyClass} data-toc-style={tocStyle || undefined}>
    <nav class="nav" id="site-nav">
      <div class="nav-inner">

        <!-- Three things, the middle one at the bar's exact centre: the four
             rooms (the site), the mark (the way home, and the divider), and
             this page's trail and controls. On phones the rooms leave for the
             sheet behind the burger, and the rest sits left-aligned. -->
        <div class="nav-site">
          <!-- one solid plane of the painting's lavender, to the screen's edge -->
          <div class="nav-paint" aria-hidden="true"></div>
          <div class="nav-links-wrap">
            <span class="nav-glide" aria-hidden="true"></span>
            <ul class="nav-links">
              {links.map((l) => (
                <li>
                  <a href={l.href} class:list={[`room-${TINTS[l.href]}`, l.active && 'active']}>{l.label}</a>
                </li>
              ))}
            </ul>
          </div>
        </div>

        <!-- the centre of the bar is the way home: the mark, in a wide cell of
             its own, divides the site (left) from this page (right) -->
        <a class:list={['nav-mark', isHome && 'is-here']} href="/" aria-label="খান মুহাম্মদ বিন আসাদ — প্রথম পাতা">
          <svg viewBox="0 0 100 100" aria-hidden="true" focusable="false">
            <circle class="nm-ring" cx="50" cy="50" r="42" />
            <g class="nm-ticks">
              {markTicks.map((t) => <line x1={t.x1} y1={t.y1} x2={t.x2} y2={t.y2} />)}
            </g>
            <circle class="nm-zenith" cx="50" cy="8" r="6.5" />
          </svg>
        </a>

        <!-- this page: breadcrumb and gilt key; site.js adds the সূচি here
             (inside the gilt key, or on its own when there is no breadcrumb) -->
        <div class="nav-page">
          {!navTitle && isHome && <span class="nav-site-name">{SITE_NAME}</span>}
          {navTitle && (
            <div class="nav-page-info">
              {ancestors.map((a) => (
                <>
                  <a class="nav-parent" href={a.href}>{a.label}</a>
                  <NavChevron />
                </>
              ))}

              <!-- a section may step in one more crumb of its own here — it
                   need not be a link (Panthea's ধাপ key opens the floor grid);
                   it draws its own trailing <NavChevron /> -->
              <slot name="nav-crumbs" />

              <span class="nav-here">
                <!-- site.js slots the সূচি inside this gilt key; the whole
                     key then opens the table of contents. The title is the
                     default — a section needing controls beside it (Panthea's
                     ↑ তলা ২৫১ ↓) replaces the whole content, keeping .nav-cur. -->
                <slot name="nav-here"><span class="nav-cur">{navTitle}</span></slot>
              </span>
            </div>
          )}
        </div>

        <!-- phones only: the burger, which brings the sheet down -->
        <button class="nav-burger" type="button" aria-expanded="false"
                aria-controls="nav-sheet" aria-label="মেনু">
          <span></span><span></span><span></span>
        </button>

      </div>

      <!-- how far through the page you are — drawn along the bar's edge -->
      <span class="nav-progress" aria-hidden="true"></span>
    </nav>

    <!-- The sheet — phones only. The burger brings it down over the whole
         screen: the site's rooms, large, each with its gloss. Kept outside
         <nav> so its fixed position answers to the viewport. -->
    <div class="nav-sheet" id="nav-sheet" aria-hidden="true">
      <nav class="nav-sheet-inner" aria-label="বিভাগসমূহ">
        <a class:list={['nav-sheet-item', isHome && 'active']} href="/">
          <span class="nav-sheet-label">প্রথম পাতা</span>
          <span class="nav-sheet-gloss">যৌথ অচেতন</span>
        </a>
        {links.map((l) => (
          <a class:list={['nav-sheet-item', `room-${TINTS[l.href]}`, l.active && 'active']} href={l.href}
             aria-current={l.active ? 'page' : undefined}>
            <span class="nav-sheet-label">{l.label}</span>
            <span class="nav-sheet-gloss">{l.gloss}</span>
          </a>
        ))}
      </nav>
    </div>

    <slot />

    <!-- the foot of every page, full width at the very bottom (SiteFoot) -->
    <SiteFoot prev={footPrev || null} next={footNext || null} />
  </body>
</html>
