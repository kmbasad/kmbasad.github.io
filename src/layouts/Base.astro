---
import SiteFoot from '../components/SiteFoot.astro';
import Mark from '../components/Mark.astro';
import { ROOMS, SITE_NAME } from '../data/rooms.js';
import { UI } from '../data/ui.js';

interface Props {
  title?: string;
  description?: string;
  section?: 'panthea' | 'pangea' | 'translations' | 'gadya' | 'trellises' | '';
  bodyClass?: string;
  styles?: string[];
  navTitle?: string;            // this page's name: the rail's title, and the tab's
  navParentHref?: string;       // the trail, outward from the page
  navParentLabel?: string;
  navGrandParentHref?: string;
  navGrandParentLabel?: string;
  tocStyle?: '' | 'grid';       // the contents as a list of names, or a grid of numbers
  rail?: boolean;               // a long page: the reading rail stands beside it
  footPrev?: string | null;     // the previous and next reading, shown in the rail only
  footNext?: string | null;
  prevLabel?: string;           // their names, when the page knows them
  nextLabel?: string;
  chrome?: boolean;             // false: no masthead and no footer (the home)
  foot?: boolean;               // false: no footer (a page held to one screen)
}

const {
  title = '',
  description = 'যৌথ অচেতন — খান মুহাম্মদ বিন আসাদ: প্যান্থিয়া, প্যাঞ্জিয়া, কবিতা, গদ্য, মাচা।',
  section = '',
  bodyClass = '',
  styles = [],
  navTitle = '',
  navParentHref = '',
  navParentLabel = '',
  navGrandParentHref = '',
  navGrandParentLabel = '',
  tocStyle = '',
  rail = false,
  footPrev = null,
  footNext = null,
  prevLabel = '',
  nextLabel = '',
  chrome = true,
  foot = true,
} = Astro.props;

/* The tab title is the page's whole trail read outward, ending at the
   site's name. Pages with a trail derive it from their nav props; pages
   without one pass `title` (their h1); home gets the bare site name. */
const crumbChain = navTitle ? [navTitle, navParentLabel, navGrandParentLabel] : [title];
const pageTitle = crumbChain
  .filter(Boolean)
  .filter((s) => s !== SITE_NAME)
  .concat(SITE_NAME)
  .join(' — ');

const room = ROOMS.find((r) => r.key === section);

/* The rail's trail: the room first (its kicker), then the ancestors between
   it and this page, outermost first. The room's own index is the kicker, so
   it is not said twice. */
const ancestors = [
  { href: navGrandParentHref, label: navGrandParentLabel },
  { href: navParentHref,      label: navParentLabel },
].filter((a) => a.href && a.label && a.href !== room?.href);


/* The selvedge: a thin band of the painting along the masthead's top edge,
   the five rooms' tints among cream and lavender, irregular as in 1913. */
const STRIP = [
  ['blue', 13], ['cream', 5], ['pink', 8], ['lav', 19], ['ochre', 4], ['clay', 3], ['sage', 10],
  ['cream', 7], ['blue', 6], ['pink', 3], ['lav', 9], ['ochre', 9], ['clay', 6], ['sage', 4], ['blue', 3],
];
const hasPager = !!(footPrev || footNext);
const hasCrumbs = Astro.slots.has('rail-crumbs');

/* The band under the page's name in the rail: a strip of the painting, its
   planes cut from a seed taken from the page's path, so every page has its
   own and keeps it. The room's tint carries the most of it; cream, lavender
   and paper between, one note of another room's tint. */
const band = (() => {
  let seed = [...Astro.url.pathname].reduce((h, ch) => (h * 31 + ch.charCodeAt(0)) | 0, 7);
  const rnd = () => {
    seed = (seed + 0x6d2b79f5) | 0;
    let t = Math.imul(seed ^ (seed >>> 15), 1 | seed);
    t = (t + Math.imul(t ^ (t >>> 7), 61 | t)) ^ t;
    return ((t ^ (t >>> 14)) >>> 0) / 4294967296;
  };
  const t = room?.tint ?? 'blue';
  const others = ROOMS.filter((r) => r.key !== room?.key);
  const other = others[Math.floor(rnd() * others.length)]?.tint ?? 'pink';
  const fills = [`var(--t-${t}-d)`, 'var(--paper)', `var(--t-${t})`, 'var(--t-cream)',
                 `var(--t-${t}-d)`, 'var(--t-lav)', `var(--t-${other})`, 'var(--paper)'];
  // shuffle lightly, keep the room's deep tint first so it opens the strip
  for (let i = fills.length - 1; i > 1; i--) {
    const j = 1 + Math.floor(rnd() * i);
    [fills[i], fills[j]] = [fills[j], fills[i]];
  }
  return fills.map((c) => ({ c, w: 1 + Math.floor(rnd() * 6) }));
})();

/* the way on: a plain line arrow, drawn once, mirrored for the way back */
const arrowPath = 'M3 10h13.5M11.5 5l5 5-5 5';
---

<!DOCTYPE html>
<html lang="bn">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="theme-color" content="#fcfcfb" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Noto+Serif+Bengali:wght@300;400;500;600;700&family=Tiro+Bangla:ital@0;1&display=swap"
    />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate icon" href="/favicon-32.png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <link rel="stylesheet" href="/css/style.css" />
    <link rel="stylesheet" href="/css/chrome.css" />
    {styles.map((href) => <link rel="stylesheet" href={href} />)}

    <script is:inline defer src="/js/site.js"></script>
    {/* dev only: Ctrl+click any text to edit it in place (src/dev/edit.js) */}
    {import.meta.env.DEV && <script is:inline defer src="/__edit/edit.js"></script>}
    {/* dev only: select any text to leave Claude a comment (src/dev/comments.js) */}
    {import.meta.env.DEV && <script is:inline defer src="/__edit/comments.js"></script>}

    <slot name="head" />
  </head>

  <body class:list={[bodyClass, room && `room-${room.tint}`, rail && 'has-rail', !chrome && 'no-chrome']} data-toc-style={tocStyle || undefined}>
    {chrome && (
      <header class="mast" id="site-nav">
        <div class="selvedge" aria-hidden="true">
          {STRIP.map(([c, w]) => <span class={`sv-${c}`} style={`flex-grow:${w}`}></span>)}
        </div>
        <div class="mast-inner">
          <a class="mast-home" href="/" aria-label={UI.home}>
<Mark class="mast-mark" breathe />
            <span class="mast-name">{SITE_NAME}</span>
          </a>

          <nav class="mast-rooms" aria-label={UI.sections}>
            {ROOMS.map((r) => (
              <a href={r.href} class:list={['mast-room', `room-${r.tint}`, r.key === section && 'active']}
                 aria-current={r.key === section ? 'true' : undefined}>{r.label}</a>
            ))}
          </nav>

          <!-- phones: the burger brings the rooms down as a sheet -->
          <button class="mast-burger" type="button" aria-expanded="false"
                  aria-controls="nav-sheet" aria-label={UI.menu}>
            <span></span><span></span>
          </button>
        </div>
      </header>
    )}

    {chrome && (
      <div class="nav-sheet" id="nav-sheet" aria-hidden="true">
        <nav class="nav-sheet-inner" aria-label={UI.sections}>
          <a class="nav-sheet-item nav-sheet-home" href="/">
            <span class="nav-sheet-label">{SITE_NAME}</span>
            <span class="nav-sheet-gloss">{UI.home}</span>
          </a>
          {ROOMS.map((r) => (
            <a class:list={['nav-sheet-item', `room-${r.tint}`, r.key === section && 'active']} href={r.href}
               aria-current={r.key === section ? 'page' : undefined}>
              <span class="nav-sheet-label">{r.label}</span>
              <span class="nav-sheet-gloss">{r.gloss}</span>
            </a>
          ))}
        </nav>
      </div>
    )}

    {rail ? (
      <div class="shell">
        <!-- The reading rail: where you are, what this page holds, and the
             way on. Beside the text on a wide screen, sticking as it scrolls;
             below that, a sheet the floating key brings up. -->
        <aside class="rail" id="rail" aria-label={UI.contents}>
          <div class="rail-inner">
            <!-- where you are: the room, the path down to this page, its name -->
            <div class="rail-head">
              {room && <a class={`rail-room room-${room.tint}`} href={room.href}>{room.label}</a>}
              {(ancestors.length > 0 || hasCrumbs) && (
                <ol class="rail-path">
                  {ancestors.map((a) => <li><a class="rail-crumb" href={a.href}>{a.label}</a></li>)}
                  <slot name="rail-crumbs" />
                </ol>
              )}
              {navTitle && <p class="rail-title">{navTitle}</p>}
              <!-- the band of the painting under the name, ending in the mark where
                   the rail's axis ends; the mark turns as the page is read -->
              <div class="rail-seal">
                <span class="rail-band" aria-hidden="true">
                  {band.map((b) => <span style={`flex-grow:${b.w};background:${b.c}`}></span>)}
                </span>
                <Mark class="rail-mark" breathe />
              </div>
              <slot name="rail-here" />
            </div>
            <!-- what it holds: site.js numbers the contents and draws the
                 reading line beside them -->
            <nav class="rail-toc" id="rail-toc" hidden></nav>
            <!-- the way on: two planes of the painting side by side; the one
                 under the pointer widens and names the page it leads to -->
            {hasPager && (
              <nav class="rail-pager" aria-label={`${UI.prev} / ${UI.next}`}>
                {footPrev
                  ? <a class="m-way m-prev" href={footPrev} rel="prev" aria-label={prevLabel ? `${UI.prev}: ${prevLabel}` : UI.prev}>
                      <svg viewBox="0 0 20 20" aria-hidden="true"><path d={arrowPath} transform="matrix(-1 0 0 1 20 0)" /></svg>
                      <span class="m-way-text"><span class="m-way-dir">{UI.prev}</span>{prevLabel && <span class="m-way-name">{prevLabel}</span>}</span>
                    </a>
                  : <span class="m-way m-prev m-off" aria-hidden="true"><svg viewBox="0 0 20 20"><path d={arrowPath} transform="matrix(-1 0 0 1 20 0)" /></svg></span>}
                {footNext
                  ? <a class="m-way m-next" href={footNext} rel="next" aria-label={nextLabel ? `${UI.next}: ${nextLabel}` : UI.next}>
                      <span class="m-way-text"><span class="m-way-dir">{UI.next}</span>{nextLabel && <span class="m-way-name">{nextLabel}</span>}</span>
                      <svg viewBox="0 0 20 20" aria-hidden="true"><path d={arrowPath} /></svg>
                    </a>
                  : <span class="m-way m-next m-off" aria-hidden="true"><svg viewBox="0 0 20 20"><path d={arrowPath} /></svg></span>}
              </nav>
            )}
          </div>
        </aside>

        <div class="shell-main">
          <slot />

        </div>
      </div>
    ) : (
      <slot />
    )}

    {rail && (
      <>
        <!-- below the wide screen: the key that brings the rail up as a sheet -->
        <button class="rail-key" type="button" aria-controls="rail" aria-expanded="false">
          <span class="rail-key-ring" aria-hidden="true"></span>
          <span class="rail-key-label">{UI.contents}</span>
        </button>
        <div class="rail-scrim" aria-hidden="true"></div>
        <!-- how far through the page you are, a hairline along the screen's top -->
        <span class="read-progress" aria-hidden="true"></span>
      </>
    )}

    {chrome && foot && <SiteFoot />}
  </body>
</html>
